+    /// miaotty: a folder-unlabeled section showing the working directory and
+    /// Copy Path / Reveal in Finder actions (Otty parity).
+    private func appendWorkingDirectorySection(to menu: NSMenu, target: TerminalController?) {
+        menu.removeItems(withIdentifiers: [
+            Self.cwdSeparatorIdentifier,
+            Self.cwdHeaderIdentifier,
+            Self.cwdCopyPathIdentifier,
+            Self.cwdRevealIdentifier,
+        ])
+
+        guard let url = target?.window?.representedURL else { return }
+
+        let separator = NSMenuItem.separator()
+        separator.identifier = Self.cwdSeparatorIdentifier
+        menu.addItem(separator)
+
+        let header = NSMenuItem(title: url.path, action: nil, keyEquivalent: "")
+        header.identifier = Self.cwdHeaderIdentifier
+        header.isEnabled = false
+        header.image = NSImage(systemSymbolName: "folder", accessibilityDescription: nil)
+        menu.addItem(header)
+
+        let copy = NSMenuItem(
+            title: "Copy Path",
+            action: #selector(TerminalWindow.miaottyCopyWorkingDirectory(_:)),
+            keyEquivalent: "")
+        copy.identifier = Self.cwdCopyPathIdentifier
+        copy.target = self
+        copy.representedObject = url
+        copy.setImageIfDesired(systemSymbolName: "doc.on.doc")
+        menu.addItem(copy)
+
+        let reveal = NSMenuItem(
+            title: "Reveal in Finder",
+            action: #selector(TerminalWindow.miaottyRevealWorkingDirectory(_:)),
+            keyEquivalent: "")
+        reveal.identifier = Self.cwdRevealIdentifier
+        reveal.target = self
+        reveal.representedObject = url
+        reveal.setImageIfDesired(systemSymbolName: "folder")
+        menu.addItem(reveal)
+    }
+
+    @objc private func miaottyCopyWorkingDirectory(_ sender: NSMenuItem) {
+        guard let url = sender.representedObject as? URL else { return }
+        let pb = NSPasteboard.general
+        pb.clearContents()
+        pb.setString(url.path, forType: .string)
+    }
+
+    @objc private func miaottyRevealWorkingDirectory(_ sender: NSMenuItem) {
+        guard let url = sender.representedObject as? URL else { return }
+        NSWorkspace.shared.activateFileViewerSelecting([url])
     }
 
     private func isTabContextMenu(_ menu: NSMenu) -> Bool {
