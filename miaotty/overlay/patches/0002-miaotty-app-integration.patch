+/// miaotty: PID of the child process (the shell) running in this surface.
+/// Published by the IO thread at spawn; read by the embedded apprt to expose
+/// `ghostty_surface_child_pid`. 0 means "not spawned yet".
+child_pid: std.atomic.Value(std.posix.pid_t) = std.atomic.Value(std.posix.pid_t).init(0),
+
+/// miaotty: stable per-surface pane id (32 hex chars, NUL-terminated).
+pane_id: [33]u8 = [_]u8{0} ** 33,
+
 /// We maintain our focus state and assume we're focused by default.
 /// If we're not initially focused then apprts can call focusCallback
 /// to let us know.
@@ -577,11 +585,26 @@ pub fn init(
     var io_thread = try termio.Thread.init(alloc);
     errdefer io_thread.deinit();
 
+    // miaotty: a stable per-surface id (32 hex chars, NUL-terminated). It is
+    // exported to the pane's environment as MIAOTTY_PANE_ID so agents can bind
+    // to their pane in O(1) instead of walking the process tree.
+    const pane_id = pane_id: {
+        var uuid: [16]u8 = undefined;
+        std.crypto.random.bytes(&uuid);
+        var buf: [33]u8 = undefined;
+        for (uuid, 0..) |b, i| {
+            _ = std.fmt.bufPrint(buf[i * 2 .. i * 2 + 2], "{x:0>2}", .{b}) catch unreachable;
+        }
+        buf[32] = 0;
+        break :pane_id buf;
+    };
+
     self.* = .{
